DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/demoforge"

# NOTE: DATABASE_URL, the two Supabase vars, and the two Clerk vars below are
# validated at startup (lib/env.ts, called from lib/prisma.ts) — the app
# refuses to boot with a clear error naming whichever of these five is
# missing/blank/malformed, rather than failing later inside a random route.
# Everything else in this file stays genuinely optional; see lib/env.ts for
# the full reasoning on what's required vs. what degrades gracefully.

# Supabase Storage
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Remotion export rendering (see DF-07/DF-07a)
# `npm run build` runs `npm run bundle:remotion` first, which writes the pre-bundled
# composition's serveUrl to .remotion/bundle.json for the worker to read at runtime.
# Only set REMOTION_SERVE_URL if you're serving an already-hosted bundle instead
# (e.g. from a CDN) and want to skip the local .remotion/bundle.json file.
# REMOTION_SERVE_URL=""
# REMOTION_BUNDLE_FILE=".remotion/bundle.json"

# Clerk (auth) — from https://dashboard.clerk.com > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# Inngest. Optional for local development when using `npx inngest-cli dev`;
# required on deployed services. The web service uses EVENT_KEY to send
# demoforge/export.requested; the worker uses SIGNING_KEY to authenticate
# Inngest callbacks.
# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""

# GitHub repo metadata (optional). Public repos work without this, but
# unauthenticated requests are capped at 60/hr; a token (no scopes needed
# for public repo metadata) raises that to 5000/hr.
# GITHUB_TOKEN=""

# PostHog analytics (DF-22). Optional — lib/analytics.ts (server) and
# lib/analytics-client.ts (browser) both no-op safely when unset, so
# analytics being unconfigured never breaks a request or a page.
# Project API key, from PostHog > Project Settings > API Keys. Used by both
# the browser client (must be NEXT_PUBLIC_ to be readable client-side) and
# the server client, which also accepts the unprefixed POSTHOG_KEY.
# NEXT_PUBLIC_POSTHOG_KEY=""
# POSTHOG_KEY=""
# Defaults to PostHog Cloud (US) if unset. Use https://eu.i.posthog.com for
# an EU-hosted project, or your self-hosted instance's URL.
# NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# POSTHOG_HOST="https://us.i.posthog.com"

# Playwright E2E suite (DF-21.6) — see playwright.config.ts and
# e2e/global.setup.ts. Reuses the Clerk keys above, plus:
# An existing user's email on that *same dev instance*. Signing in by email
# (rather than password) lets `@clerk/testing` mint a session via Clerk's
# Backend API, bypassing verification/MFA entirely — never point this at a
# production Clerk instance.
# E2E_CLERK_USER_EMAIL=""
# Override only if the app under test isn't on the default http://localhost:3000
# (e.g. a different PORT, or a already-running server in a different env).
# E2E_BASE_URL=""
